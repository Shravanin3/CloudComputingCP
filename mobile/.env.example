# Mock data fallback toggle: set to false to use the live backend API
EXPO_PUBLIC_USE_MOCK_DATA=false

# Backend API Base URL configuration (Must include /api/v1)
# 1. Expo Web (browser on same machine):
#    EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# 2. Android Emulator (Standard AVD):
#    EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api/v1
# 3. Physical Device (Expo Go on Android/iOS via Wi-Fi):
#    Replace <YOUR_LAN_IP> with your development PC's local IP (e.g., from `ipconfig`)
#    Ensure both your phone and PC are connected to the same Wi-Fi network.
#    EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
