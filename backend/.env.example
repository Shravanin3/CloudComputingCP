# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format for Local: postgresql://postgres:postgres@localhost:5432/msmedb?schema=public
# Format for Azure: postgresql://<user>:<password>@<server-name>.postgres.database.azure.com:5432/msmedb?sslmode=require&schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/msmedb?schema=public"

# JWT Authentication Secrets
JWT_SECRET="super-secure-production-jwt-secret-key-msme-fintech"
JWT_EXPIRES_IN="7d"

# Azure Cloud Storage Configuration (Handed off to Member 3/4)
AZURE_STORAGE_ACCOUNT="msmefintechstorage"
AZURE_STORAGE_CONTAINER="invoices"
AZURE_KEY_VAULT_URL="https://msme-fintech-kv.vault.azure.net/"
