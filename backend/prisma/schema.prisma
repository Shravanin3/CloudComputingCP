// Prisma Schema for Cloud-Native Multi-Tenant FinTech Platform for MSMEs
// Owned and Architected by Member 2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 1. TENANTS & IDENTITY (Multi-Tenant Core)
// ---------------------------------------------------------

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum UserRole {
  Owner
  Admin
  Cashier
}

model Tenant {
  id               String           @id @default(uuid()) @map("tenant_id") @db.Uuid
  shopName         String           @map("shop_name") @db.VarChar(255)
  gstinNumber      String?          @map("gstin_number") @db.VarChar(15)
  address          String?          @map("address") @db.Text
  subscriptionTier SubscriptionTier @default(FREE) @map("subscription_tier")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  users         User[]
  categories    Category[]
  products      Product[]
  inventories   Inventory[]
  customers     Customer[]
  suppliers     Supplier[]
  sales         Sale[]
  saleItems     SaleItem[]
  purchases     Purchase[]
  purchaseItems PurchaseItem[]
  expenses      Expense[]
  transactions  Transaction[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid()) @map("user_id") @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @map("name") @db.VarChar(255)
  role         UserRole  @default(Cashier)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------
// 2. MASTER CATALOG & INVENTORY
// ---------------------------------------------------------

model Category {
  id        String    @id @default(uuid()) @map("category_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id           String    @id @default(uuid()) @map("product_id") @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  categoryId   String?   @map("category_id") @db.Uuid
  name         String    @db.VarChar(255)
  sku          String?   @db.VarChar(100)
  sellingPrice Decimal   @map("selling_price") @db.Decimal(12, 2)
  costPrice    Decimal   @map("cost_price") @db.Decimal(12, 2)
  attributes   Json      @default("{}") @map("attributes")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory     Inventory?
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@index([tenantId])
  @@index([tenantId, id])
  @@map("products")
}

model Inventory {
  id                String    @id @default(uuid()) @map("inventory_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  productId         String    @unique @map("product_id") @db.Uuid
  stockQuantity     Int       @default(0) @map("stock_quantity")
  lastRestockedDate DateTime  @default(now()) @map("last_restocked_date") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, productId])
  @@map("inventory")
}

// ---------------------------------------------------------
// 3. STAKEHOLDERS (Customers & Suppliers)
// ---------------------------------------------------------

model Customer {
  id            String    @id @default(uuid()) @map("customer_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String    @db.VarChar(255)
  phone         String    @db.VarChar(20)
  creditBalance Decimal   @default(0.00) @map("credit_balance") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  Sale[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("customers")
}

model Supplier {
  id             String     @id @default(uuid()) @map("supplier_id") @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  name           String     @db.VarChar(255)
  phone          String?    @db.VarChar(20)
  payableBalance Decimal    @default(0.00) @map("payable_balance") @db.Decimal(12, 2)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([tenantId])
  @@map("suppliers")
}

// ---------------------------------------------------------
// 4. TRANSACTIONS (Sales & Purchases)
// ---------------------------------------------------------

enum PaymentMethod {
  CASH
  UPI
  CREDIT
}

model Sale {
  id            String        @id @default(uuid()) @map("sale_id") @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  customerId    String?       @map("customer_id") @db.Uuid
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  saleDate      DateTime      @default(now()) @map("sale_date") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  saleItems SaleItem[]

  @@index([tenantId])
  @@index([tenantId, saleDate])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid()) @map("sale_item_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  saleId    String   @map("sale_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(12, 2)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([saleId])
  @@map("sale_items")
}

model Purchase {
  id            String         @id @default(uuid()) @map("purchase_id") @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  supplierId    String?        @map("supplier_id") @db.Uuid
  totalAmount   Decimal        @map("total_amount") @db.Decimal(12, 2)
  purchaseDate  DateTime       @default(now()) @map("purchase_date") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseItems PurchaseItem[]

  @@index([tenantId])
  @@index([tenantId, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid()) @map("purchase_item_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  purchaseId String   @map("purchase_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  quantity   Int
  unitCost   Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal  Decimal  @map("line_total") @db.Decimal(12, 2)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([purchaseId])
  @@map("purchase_items")
}

// ---------------------------------------------------------
// 5. EXPENSES & UNIFIED DOUBLE-ENTRY LEDGER
// ---------------------------------------------------------

model Expense {
  id          String   @id @default(uuid()) @map("expense_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @db.VarChar(100)
  description String?  @db.Text
  expenseDate DateTime @default(now()) @map("expense_date") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, expenseDate])
  @@map("expenses")
}

enum EntityType {
  CUSTOMER
  SUPPLIER
}

enum ReferenceType {
  SALE
  PURCHASE
  PAYMENT
}

model Transaction {
  id            String        @id @default(uuid()) @map("transaction_id") @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  entityType    EntityType    @map("entity_type")
  entityId      String        @map("entity_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2) // Positive for credit, Negative for debit
  referenceType ReferenceType @map("reference_type")
  referenceId   String        @map("reference_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityId])
  @@map("transactions")
}
